<Window x:Class="RadishDeck.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RadishDeck.Core;assembly=RadishDeck.Core"
        Title="Radish Deck" Width="1400" Height="900" MinWidth="1100" MinHeight="700"
        Background="#080A0B" Foreground="#F4F4F4">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#171A1C"/><Setter Property="Foreground" Value="#F4F4F4"/>
            <Setter Property="BorderBrush" Value="#363A3D"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="#111416"/><Setter Property="Foreground" Value="#F4F4F4"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#24282B" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RADISH" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text=" DECK" FontSize="28" FontWeight="Bold" Foreground="#E11D2E"/>
                    <TextBlock Text="{x:Static core:AppVersion.Current}" Margin="20,8,0,0" FontSize="16" Foreground="#B8B8B8"/>
                </StackPanel>
                <WrapPanel>
                    <Button Content="Страницы" IsEnabled="False"/><Button Content="Элементы" IsEnabled="False"/>
                    <Button Content="Действия" Click="ActionsTab_Click"/><Button Content="Плагины" IsEnabled="False"/>
                    <Button Content="Профили" IsEnabled="False"/><Button Content="Настройки" IsEnabled="False"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="#24282B" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="SERVER" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="StartServerButton" Content="▶ Запустить сервер" Background="#087A42" Click="StartServerButton_OnClick"/>
                    <Button x:Name="RestartServerButton" Content="🔄 Перезапустить сервер" Click="RestartServerButton_OnClick"/>
                    <Button x:Name="StopServerButton" Content="■ Остановить сервер" Click="StopServerButton_OnClick"/>
                    <TextBlock Text="IP" Margin="8"/><TextBox x:Name="IpAddressTextBox" Text="127.0.0.1" Width="130"/>
                    <TextBlock Text="Port" Margin="8"/><TextBox x:Name="PortTextBox" Text="5187" Width="70"/>
                    <TextBlock x:Name="ServerStatusText" Margin="14,8"/>
                    <TextBlock x:Name="ServerVersionText" Margin="14,8"/>
                </WrapPanel>
                <TextBlock x:Name="ServerMessageText" TextWrapping="Wrap" Foreground="#B8B8B8"/>
                <Expander Header="Server diagnostics">
                    <TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
                </Expander>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,4">
            <TextBlock x:Name="ActionResultText" Text="Action: ready" TextWrapping="Wrap"/>
            <TextBlock x:Name="SaveStatusText" Text="Loading Deck…" TextWrapping="Wrap" Foreground="#B8B8B8"/>
        </StackPanel>
        <Grid x:Name="EditorPanel" Margin="12" IsEnabled="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <Border Background="#0D1012" BorderBrush="#24282B" BorderThickness="1" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="СТРАНИЦЫ" FontSize="20" FontWeight="Bold"/>
                        <Button Content="＋ Добавить страницу" Click="AddPage_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBox x:Name="PageNameTextBox"/>
                        <Button Content="Переименовать страницу" Click="RenamePage_Click"/>
                        <Button x:Name="DeletePageButton" Content="Удалить страницу" Click="DeletePage_Click"/>
                    </StackPanel>
                    <ListBox x:Name="PagesList" Background="Transparent" Foreground="#F4F4F4" BorderThickness="0"
                             DisplayMemberPath="Name" SelectionChanged="PageSelectionChanged"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Margin="12,0" Background="#0B0D0F" BorderBrush="#24282B" BorderThickness="1" Padding="16">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="CurrentPageText" FontSize="20" FontWeight="Bold"/>
                        <Button Content="＋ Button" Click="AddElement_Click"/>
                        <Button Content="Удалить элемент" Click="DeleteElement_Click"/>
                    </WrapPanel>
                    <Canvas x:Name="DeckGrid" Margin="0,12" Background="#101416" Width="800" Height="500"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="#0D1012" BorderBrush="#24282B" BorderThickness="1" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertiesPanel" IsEnabled="False">
                        <TextBlock Text="BUTTON / СВОЙСТВА" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Название"/><TextBox x:Name="ElementNameTextBox"/>
                        <TextBlock Text="Действие (Action Registry)"/>
                        <ComboBox x:Name="ActionComboBox" Margin="4" Padding="6" Foreground="Black"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ActionSelectionChanged"/>
                        <StackPanel x:Name="UrlPanel" Visibility="Collapsed">
                            <TextBlock Text="URL (HTTP/HTTPS)"/><TextBox x:Name="UrlTextBox"/>
                        </StackPanel>
                        <StackPanel x:Name="ProcessPathPanel" Visibility="Collapsed">
                            <TextBlock Text="Executable (.exe absolute path)"/><TextBox x:Name="ProcessPathTextBox"/>
                        </StackPanel>
                        <TextBlock Text="Type: Button"/>
                        <TextBlock Text="X / Y (Canvas)"/>
                        <UniformGrid Columns="2"><TextBox x:Name="XTextBox"/><TextBox x:Name="YTextBox"/></UniformGrid>
                        <TextBlock Text="Ширина / Высота (Canvas)"/>
                        <UniformGrid Columns="2"><TextBox x:Name="WidthTextBox"/><TextBox x:Name="HeightTextBox"/></UniformGrid>
                        <Button Content="Применить свойства" Click="ApplyElement_Click"/>
                        <Button x:Name="ExecuteElementButton" Content="Выполнить элемент" Click="ExecuteElement_Click"/>
                        <TextBlock Text="Клик выбирает кнопку. Выполнить запускает действие. Примените изменения перед переключением страницы."
                                   TextWrapping="Wrap" Foreground="#AAAAAA" Margin="4,12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
