<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RadishDeck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\RadishDeck.Core\RadishDeck.Core.csproj" />
    <ProjectReference Include="..\RadishDeck.Infrastructure\RadishDeck.Infrastructure.csproj" />
    <ProjectReference Include="..\RadishDeck.Server\RadishDeck.Server.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Build-only dependency; Server remains a separate process. -->
  <Target Name="BundleServerForBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\RadishDeck.Server\RadishDeck.Server.csproj" Targets="Publish"
             RemoveProperties="TargetFramework;PublishUrl"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(TargetDir)server/'));UseAppHost=true" />
  </Target>
  <Target Name="BundleServerForPublish" AfterTargets="Publish">
    <MSBuild Projects="..\RadishDeck.Server\RadishDeck.Server.csproj" Targets="Publish"
             RemoveProperties="TargetFramework;PublishUrl"
             Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)server/'));UseAppHost=true" />
  </Target>
</Project>
